# ==============================================================================
# STORE INTELLIGENCE SYSTEM ENVIRONMENT VARIABLES - BLUEPRINT (.env.example)
# Copy this file to '.env' and populate with local values.
# ==============================================================================

# Project Identification
PROJECT_NAME="Purplle Store Intelligence System"
VERSION="1.0.0"

# Application Running Environment (development, testing, production)
ENVIRONMENT=development

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY="supersecretpurpllestoreintelligencekey"

# Database Configuration (PostgreSQL)
# Local setup example:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/store_intelligence"
# Dockerized Compose network path:
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/store_intelligence"

# High-Performance Caching & Ingestion Broker (Redis)
# Local setup example:
REDIS_URL="redis://localhost:6379/0"
# Dockerized Compose network path:
# REDIS_URL="redis://redis:6379/0"

# Computer Vision & Multi-Object Tracking Engine Settings
# Path to YOLOv8 Weights (e.g. yolov8n.pt, yolov8s.pt, custom.pt)
MODEL_PATH="yolov8n.pt"

# Local directories for data ingestion and exports
VIDEO_DIR="./data/videos"
EVENT_OUTPUT_DIR="./data/events"

# Logging configuration (TRACE, DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE_PATH="./logs/store_intelligence.log"
